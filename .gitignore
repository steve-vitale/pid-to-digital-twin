__pycache__/
# Third-party downloads stay out of git, except the drawings every step uses (PID2Graph, CC BY-SA 4.0; NOTICE.md):
# the 12 OPEN100 sheets with their answer keys, and their degraded "old scan" copies (scripts/degrade_scans.py).
data/external/*
!data/external/pid2graph/
data/external/pid2graph/*
!data/external/pid2graph/PID2Graph/
data/external/pid2graph/PID2Graph/*
!data/external/pid2graph/PID2Graph/Complete/
data/external/pid2graph/PID2Graph/Complete/*
!data/external/pid2graph/PID2Graph/Complete/PID2Graph OPEN100/
!data/external/pid2graph/PID2Graph/Complete/PID2Graph OPEN100 scan-L1/
!data/external/pid2graph/PID2Graph/Complete/PID2Graph OPEN100 scan-L2/
!data/external/pid2graph/PID2Graph/Complete/PID2Graph OPEN100 scan-L3/
.env
.venv/
*.gwbk
*.key
runs/*/
!runs/README.md
out/twin/*
!out/twin/round1-v2-named-fields/
out/twin/round1-v2-named-fields/*
!out/twin/round1-v2-named-fields/claude/
!out/twin/round1-v2-named-fields/twin_scores.*
!out/twin/r2-tiles-trace/
out/twin/r2-tiles-trace/*
!out/twin/r2-tiles-trace/codex/
!out/twin/r2-tiles-trace/twin_scores.*
out/confidence_cache/
out/confidence/

# Generated review previews and local decision evidence are not publication inputs.
out/process_mimic/*
!out/process_mimic/VERIFICATION.txt
out/review/

# Degraded copies of the generated TE sheets: regenerate with
# python scripts/degrade_scans.py --src data/te_pid --drawings 101,102,103 --dest data/te_pid/scan
data/te_pid/scan-L*/
data/te_pid/rev-c/scan-L*/

# OPEN100 structural outputs: the JSON/CSV results and the spot-check crops are committed; renders, previews and
# working crops are regenerated (scripts/render_open100_structural.py, scripts/build_open100_3d.py).
out/open100_structural/mimic/*.html
out/open100_structural/3d/renders/
out/open100_structural/3d/open100_scene_blender.py
out/open100_structural/schedule_crops/

# 3D tour (proof of concept): scene JSON, generated Blender script and full-size renders are regenerable
# (python scripts/build_3d_scene.py); the review stills and their measured label boxes are committed under drafts/3d-tour/.
out/3d/

# Interactive tour (proof of concept): the built pages embed the downloaded replay, which is not redistributed;
# rebuild with python scripts/pipeline.py rebuild --from te.interactive_tour. The audit and review stills are committed under drafts/interactive-tour/.
out/interactive_tour/
