# Prompt files are hashed into every run record; keep their bytes identical on every OS.
extraction/* text eol=lf
*.bat text eol=crlf
# The timed-review kit is hashed in its manifest; keep its bytes identical on every OS.
out/review_kit/** -text

# Patches are applied with git apply; keep their bytes identical on every OS.
*.patch -text

# Worked examples whose tests compare the regenerated bytes; keep them identical on every OS.
examples/review-and-mapping/** -text
examples/own-drawing/deliverable/** -text
# The intake hashes this original extraction's raw bytes into its model and graph.
examples/own-drawing/extraction_sheet0.json -text
# The mapping report fingerprints this synthetic CSV's raw bytes; pin the fixture across operating systems.
data/io_lists/open100_sheet0_demo.csv text eol=lf

# Committed predictions (scripts/rescore.py writes them with LF); keep their bytes identical on every OS.
predictions/** text eol=lf
# Context source bytes and decision snapshots must reproduce across operating systems.
examples/context-register/** text eol=lf
# The current statement review example binds canonical JSON and hashes its generated packet bytes.
examples/statement-review/bound-sheet0/*.json text eol=lf
examples/statement-review/bound-sheet0/*.csv text eol=lf
examples/statement-review/bound-sheet0/*.html text eol=lf
